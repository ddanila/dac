{
  "name": "dac-museum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:cross": "playwright test -c playwright.cross.config.js",
    "review:robotron": "node scripts/review-robotron.mjs",
    "test:historical": "DAC_HISTORICAL_QUALIFICATION=1 playwright test tests/historical-media.spec.js tests/historical-workflow.spec.js tests/drive-regression.spec.js --workers=1",
    "test:analyzer": "node tools/analyzer/core.test.mjs",
    "test:analyzer:scale": "node tools/analyzer/scale.mjs",
    "test:investigation": "node tools/analyzer/investigation.test.mjs && node tools/analyzer/source.test.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@playwright/test": "1.64.0"
  }
}
