  "source": {
    "name": "p1715test.asm",
    "sha256": "76c8c003a4ab0ad99f61c775589bc6c5a827494a47d1cb2b2292b9848794b8e9",
    "text": "; SPDX-License-Identifier: MIT\n; Portable CP/M 2+ diagnostic. All disk access uses BDOS, never direct ports.\n        org 100h\n        ld (oldsp),sp\n        ld sp,stacktop\n        ld de,banner\n        call print\n        ld a,(80h)\n        or a\n        jp z,info\n        ld hl,81h\nskip:   ld a,(hl)\n        cp ' '\n        jr nz,command\n        inc hl\n        jr skip\ncommand:\n        and 0dfh\n        cp 'W'\n        jp z,write_test\n        cp 'R'\n        jp z,read_test\n        cp 'C'\n        jp z,cleanup\n        cp 'K'\n        jp z,keyboard\n        cp 'I'\n        jp z,info\n        ld de,usage\n        jp finish\ninfo:   ld c,12\n        call 5\n        ld a,h\n        call hexbyte\n        ld a,l\n        call hexbyte\n        ld de,info_ok\n        jp finish\nwrite_test:\n        call reset_fcb\n        ld c,15\n        ld de,fcb\n        call bdos\n        cp 0ffh\n        jp nz,collision\n        call reset_fcb\n        ld c,22\n        ld de,fcb\n        call bdos\n        cp 0ffh\n        jp z,iofail\n        xor a\n        ld (record),a\nwrite_loop:\n        call pattern\n        call dma\n        ld c,21\n        ld de,fcb\n        call bdos\n        or a\n        jp nz,writefail\n        ld a,(record)\n        inc a\n        ld (record),a\n        jr nz,write_loop\n        call close\n        jp nz,iofail\n        ld de,write_ok\n        jp finish\nread_test:\n        call verify\n        jp nz,verifyfail\n        ld de,read_ok\n        jp finish\ncleanup:\n        call verify\n        jp nz,verifyfail\n        call reset_fcb\n        ld c,19\n        ld de,fcb\n        call bdos\n        cp 0ffh\n        jp z,iofail\n        ld de,clean_ok\n        jp finish\nkeyboard:\n        ld de,key_prompt\n        call print\n        ld c,1\n        call bdos\n        ld de,key_ok\n        jp finish\n; Verify exact 256-record length, then random reads in reverse order.\nverify:\n        call reset_fcb\n        ld c,15\n        ld de,fcb\n        call bdos\n        cp 0ffh\n        jr z,bad\n        ld c,35\n        ld de,fcb\n        call bdos\n        ld a,(fcb+33)\n        or a\n        jr nz,verify_bad\n        ld a,(fcb+34)\n        cp 1\n        jr nz,verify_bad\n        ld a,(fcb+35)\n        or a\n        jr nz,verify_bad\n        ld a,255\n        ld (record),a\nverify_loop:\n        call pattern\n        ld a,(record)\n        ld (fcb+33),a\n        xor a\n        ld (fcb+34),a\n        ld (fcb+35),a\n        ld de,readbuf\n        ld c,26\n        call bdos\n        ld de,fcb\n        ld c,33\n        call bdos\n        or a\n        jr nz,verify_bad\n        ld hl,buffer\n        ld de,readbuf\n        ld b,128\ncompare:\n        ld a,(de)\n        cp (hl)\n        jr nz,verify_bad\n        inc hl\n        inc de\n        djnz compare\n        ld a,(record)\n        sub 1\n        ld (record),a\n        jr nc,verify_loop\n        call close\n        ret\nverify_bad:\n        call close\nbad:    ld a,1\n        or a\n        ret\npattern:\n        ld hl,buffer\n        ld b,128\n        ld c,0\npattern_loop:\n        ld a,(record)\n        xor c\n        ld (hl),a\n        inc hl\n        inc c\n        djnz pattern_loop\n        ld a,(record)\n        or a\n        ret nz\n        ld hl,signature\n        ld de,buffer\n        ld bc,16\n        ldir\n        ret\ndma:    ld c,26\n        ld de,buffer\n        jp bdos\nclose:  ld c,16\n        ld de,fcb\n        call bdos\n        cp 0ffh\n        jr z,bad\n        xor a\n        ret\nreset_fcb:\n        ld hl,fcb\n        ld de,fcb+1\n        ld bc,35\n        ld (hl),0\n        ldir\n        ld hl,filename\n        ld de,fcb+1\n        ld bc,11\n        ldir\n        ret\nbdos:   push bc\n        push de\n        push hl\n        call 5\n        pop hl\n        pop de\n        pop bc\n        ret\nprint:  ld c,9\n        jp bdos\nhexbyte:\n        push af\n        rrca\n        rrca\n        rrca\n        rrca\n        call nibble\n        pop af\nnibble: and 15\n        add a,'0'\n        cp '9'+1\n        jr c,hexout\n        add a,7\nhexout: ld e,a\n        ld c,2\n        jp bdos\nwritefail:\n        call close\niofail: ld de,io_error\n        jp finish\nverifyfail:\n        ld de,verify_error\n        jp finish\ncollision:\n        call close\n        ld de,exists_error\nfinish: call print\n        ld sp,(oldsp)\n        ret\nbanner: db 'P1715TEST v1 CP/M BDOS=', '$'\ninfo_ok: db 13,10,'P1715TEST INFO PASS',13,10,'W=create 32KiB scratch; R=verify after cold boot; C=verify+delete; K=keyboard',13,10,'$'\nusage: db 13,10,'Usage: P1715TST [I|W|R|C|K]',13,10,'$'\nwrite_ok: db 13,10,'P1715TEST WRITE PASS records=256; cold boot then R',13,10,'$'\nread_ok: db 13,10,'P1715TEST VERIFY PASS records=256',13,10,'$'\nclean_ok: db 13,10,'P1715TEST CLEAN PASS',13,10,'$'\nkey_prompt: db 13,10,'Press one key; visually check the echo: $'\nkey_ok: db 13,10,'P1715TEST KEYBOARD OBSERVED (operator must assess echo)',13,10,'$'\nio_error: db 13,10,'P1715TEST IO FAIL (partial scratch may remain)',13,10,'$'\nverify_error: db 13,10,'P1715TEST VERIFY FAIL; file retained',13,10,'$'\nexists_error: db 13,10,'P1715TEST COLLISION FAIL; file retained',13,10,'$'\nfilename: db 'P1715TSTDAT'\n        ; CP/M filename must occupy exactly 11 bytes: 8 name + 3 extension.\nsignature: db 'P1715TEST-v1',0,1,2,3\noldsp:  dw 0\nrecord: db 0\nfcb:    ds 36\nbuffer: ds 128\nreadbuf: ds 128\n        ds 128\nstacktop:\n"
  },
